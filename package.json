{
  "name": "taglingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:ocr": "node scripts/prepare-ocr-assets.mjs",
    "prebuild": "npm run assets:ocr",
    "predev": "npm run assets:ocr",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
